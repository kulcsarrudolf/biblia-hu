{
  "name": "biblia-hu",
  "version": "0.0.0",
  "description": "Hungarian Bible translations (RÚF 2014, Revideált Károli 2011) library and CLI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "bin/**/*",
    "json/**/*",
    "README.md"
  ],
  "bin": {
    "biblia": "./bin/biblia.js"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "tsx scripts/verify-data.ts",
    "import:ruf": "tsx scripts/import-ruf.ts",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kulcsarrudolf/biblia-hu.git"
  },
  "author": "Kulcsar Rudolf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kulcsarrudolf/biblia-hu/issues"
  },
  "homepage": "https://github.com/kulcsarrudolf/biblia-hu#readme",
  "keywords": [
    "biblia",
    "bible",
    "hungarian",
    "magyar",
    "ruf",
    "karoli",
    "veritas",
    "revideált"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.4.2",
    "cheerio": "^1.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "pinst": "^3.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
